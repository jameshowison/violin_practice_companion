<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12: the app icon as a tile on the icon's paper
     colour, matching iOS and the Flutter splash that takes over from it
     (lib/ui/splash/launch_splash.dart). Images from scripts/gen_app_icons.sh. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_paper" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
