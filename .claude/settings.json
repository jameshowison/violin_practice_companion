{
  "permissions": {
    "allow": [
      "Bash(/opt/homebrew/bin/flutter analyze *)",
      "Bash(/opt/homebrew/bin/flutter analyze)",
      "Bash(/opt/homebrew/bin/flutter test *)",
      "Bash(/opt/homebrew/Caskroom/flutter/3.44.0/flutter/bin/cache/dart-sdk/bin/dart analyze *)"
    ]
  },
  "enabledPlugins": {},
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/parallel_session_check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
