# Settings for tool/airplay_receiver/receiver.sh. Copy this OUTSIDE the repo
# (it names your network) and point AIRPLAY_RECEIVER_ENV at it. Sourced by bash.

RECEIVER_HOST=airplay-box.local        # how the Mac reaches the box (name or IP)
RECEIVER_ADMIN=me@airplay-box.local    # YOUR ssh login there, with sudo (setup only)
RECEIVER_NAME="AirPlay Test Speaker"   # what the phone's AirPlay list shows
MAC_IP=192.0.2.10                      # the Mac (DHCP reservation): only place the agent key works from
PHONE_IPS=192.0.2.20                   # test phone(s), comma-separated: only devices that can stream

# Optional (defaults shown):
# AGENT_KEY=$HOME/.ssh/airplay_receiver_agent
# KNOWN_HOSTS=<this file's folder>/known_hosts
# CAPTURES=<this file's folder>/captures    # keep out of any public repo
